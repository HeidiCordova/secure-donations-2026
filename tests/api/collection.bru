meta {
  name: Secure Donations API
  type: collection
}

auth {
  mode: oauth2
}

auth:oauth2 {
  grant_type: authorization_code
  callback_url: http://localhost:5173/callback
  authorization_url: {{cognitoDomain}}/oauth2/authorize
  access_token_url: {{cognitoDomain}}/oauth2/token
  client_id: {{clientId}}
  scope: openid api/projects.write api/donations.write api/donations.read api/audit.read
  pkce: true
  token_source: access_token
  token_placement: header
  token_header_prefix: Bearer
}
