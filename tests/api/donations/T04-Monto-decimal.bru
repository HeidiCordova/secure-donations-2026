meta {
  name: T04 - Monto decimal
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/donations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{donorAccessToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: 00000000-0000-4000-8000-000000000042
}

body:json {
  {
    "projectId": "{{projectId}}",
    "amountCents": 10.5
  }
}

tests {
  test("El monto decimal se rechaza", function() {
    expect(res.getStatus()).to.equal(400);
  });
}
