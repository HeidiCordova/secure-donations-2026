  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/v1/donations/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tamperedAccessToken}}
}

tests {
  test("El JWT alterado no supera la validación de firma", function() {
    expect(res.getStatus()).to.equal(401);
  });
}
