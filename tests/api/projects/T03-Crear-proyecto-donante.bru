meta {
  name: T03 - Donante no crea proyectos
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/projects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{donorAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Proyecto de prueba",
    "description": "Proyecto usado para verificar permisos de creación.",
    "goalAmountCents": 10000
  }
}

tests {
  test("Un DONANTE no puede crear proyectos", function() {
    expect(res.getStatus()).to.equal(403);
  });
}
